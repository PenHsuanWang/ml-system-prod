# Public deployment selections only. Copy to ignored .env.ml.production.
# Replace all placeholders using an approved release and capacity plan.
# Credentials/connection URLs belong in private per-role JSON files, never here.
# Use ONLY compose.ml.external-mlflow.yaml; do not combine the dev stack.
ML_RELEASE_IMAGE=registry.example.internal/ml-system@sha256:REPLACE_WITH_64_HEX_DIGEST
ML_IMAGE_DIGEST=sha256:REPLACE_WITH_THE_SAME_64_HEX_DIGEST
ML_CODE_REVISION=REPLACE_WITH_APPROVED_40_HEX_SOURCE_REVISION
ML_UID=10001
ML_GID=10001
ML_RUNTIME_ROOT=/absolute/private/ml-runtime
ML_DEPLOYMENT_CONFIG_DIR=/absolute/private/ml-role-config
ML_OPERATOR_DEFINITIONS_DIR=/absolute/approved/ml-source-definitions
ML_EXTERNAL_MLFLOW_URI=https://tracking.example.internal
ML_MLFLOW_CA_FILE=/absolute/approved/mlflow-ca.pem
ML_DATABRICKS_CONNECTIONS_CONFIG=/absolute/approved/databricks/connections.json
ML_DATABRICKS_SOURCES_CONFIG=/absolute/approved/databricks/sources.json
ML_DATABRICKS_CLIENT_SECRET_FILE=/absolute/private/databricks-oauth-secret
APP_MONGO_DATABASE=ml_identity
ML_MANAGEMENT_PORT=8000
ML_PREDICTION_PORT=8001

# These values are illustrative CPU MVP limits, not production qualification.
# Obtain resource/SLO approval and record the parsed deployment model before use.
ML_RUNTIME_PIDS_LIMIT=256
ML_MIGRATE_CPUS=1
ML_MIGRATE_MEMORY=512m
ML_MANAGEMENT_CPUS=1
ML_MANAGEMENT_MEMORY=512m
ML_RELAY_CPUS=1
ML_RELAY_MEMORY=256m
ML_SUPERVISOR_CPUS=1
ML_SUPERVISOR_MEMORY=1g
ML_CONTROL_CPUS=2
ML_CONTROL_MEMORY=2g
ML_GATEWAY_CPUS=1
ML_GATEWAY_MEMORY=256m
ML_INGESTION_CPUS=1
ML_INGESTION_MEMORY=512m
ML_OPERATOR_CPUS=1
ML_OPERATOR_MEMORY=512m
ML_API_CONCURRENCY=64
ML_GATEWAY_CONCURRENCY=64
ML_QUEUE_NAME=ml.training.v1
ML_TRAINING_TIMEOUT_SECONDS=300
ML_QUEUE_TIMEOUT_SECONDS=600
ML_CANCEL_GRACE_SECONDS=5
ML_HEARTBEAT_SECONDS=2
ML_STALE_AFTER_SECONDS=15
ML_IDEMPOTENCY_RETENTION_SECONDS=86400
ML_MAX_PENDING_JOBS_PER_TENANT=100
ML_ACK_TIMEOUT_MS=1800000
ML_PREDICTION_TIMEOUT_SECONDS=5
# Supply an approved policy for an EBM release. Empty is deliberately unqualified.
ML_EBM_QUALITY_POLICY_JSON=

# Access token alternative: connection JSON uses "access_token_env": "DATABRICKS_TOKEN"
# instead of client_id/client_secret_file. Set the token in the ignored .env file.
# DATABRICKS_TOKEN=
# In token mode set ML_DATABRICKS_CLIENT_SECRET_FILE=/dev/null (unused mount).
