# Load after .env.ml; copy to the ignored .env.ml.ingestion for local deployment.
# These are host paths, not credentials. Keep all approved inputs/configuration
# and the OAuth secret OUTSIDE ./var, which Management mounts read-write.
ML_INGESTION_INPUT_DIR=/absolute/path/to/approved-ingress-input

# Required only when adding compose.ml.databricks.yaml.
# Connections and source JSON are mounted read-only into Management and worker.
ML_DATABRICKS_CONNECTIONS_CONFIG=/absolute/path/to/approved-databricks/connections.json
ML_DATABRICKS_SOURCES_CONFIG=/absolute/path/to/approved-databricks/sources.json

# Mount this operator-owned regular non-symlink file into the worker only.
# A connection's client_secret_file is /run/secrets/databricks_client_secret.
ML_DATABRICKS_CLIENT_SECRET_FILE=/absolute/path/to/private-databricks-oauth-secret
