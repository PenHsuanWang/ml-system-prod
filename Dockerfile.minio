# MinIO Community Edition is source-only. Build the official release sources
# instead of relying on the retired minio/minio and minio/mc image repositories.
# https://github.com/minio/minio/releases/tag/RELEASE.2025-10-15T17-29-55Z
# https://github.com/minio/mc/releases/tag/RELEASE.2025-08-13T08-35-41Z
FROM golang:1.26.10-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
ARG MC_COMMIT=7394ce0dd2a80935aded936b09fa12cbb3cb8096
# Go resolves the immutable commits through its module proxy/checksum database.
# Both binaries share the module cache; no unversioned source or vendor image.
RUN go install -trimpath -ldflags="-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=${MINIO_COMMIT} -X github.com/minio/minio/cmd.ShortCommitID=9e49d5e7a648 -X github.com/minio/minio/cmd.CopyrightYear=2025" "github.com/minio/minio@${MINIO_COMMIT}" \
    && mkdir -p /licenses/minio \
    && source_dir="$(go list -m -f '{{.Dir}}' "github.com/minio/minio@${MINIO_COMMIT}")" \
    && test -n "$source_dir" \
    && cp "$source_dir/LICENSE" /licenses/minio/LICENSE
RUN go install -trimpath -ldflags="-s -w -X github.com/minio/mc/cmd.Version=2025-08-13T08:35:41Z -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2025-08-13T08-35-41Z -X github.com/minio/mc/cmd.CommitID=${MC_COMMIT} -X github.com/minio/mc/cmd.CopyrightYear=2025" "github.com/minio/mc@${MC_COMMIT}" \
    && mkdir -p /licenses/mc \
    && source_dir="$(go list -m -f '{{.Dir}}' "github.com/minio/mc@${MC_COMMIT}")" \
    && test -n "$source_dir" \
    && cp "$source_dir/LICENSE" /licenses/mc/LICENSE

FROM alpine:3.23 AS runtime
RUN apk add --no-cache ca-certificates

FROM runtime AS server
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=build /go/bin/minio /usr/local/bin/minio
COPY --from=build /licenses/minio /licenses
EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["minio"]
CMD ["server", "/data"]

FROM runtime AS client
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
      org.opencontainers.image.revision="7394ce0dd2a80935aded936b09fa12cbb3cb8096" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=build /go/bin/mc /usr/local/bin/mc
COPY --from=build /licenses/mc /licenses
ENTRYPOINT ["mc"]
