FROM python:3.12-slim
RUN pip install --no-cache-dir 'mlflow==3.6.0' 'SQLAlchemy>=2.0.44,<2.1' 'psycopg[binary]>=3.2,<4' boto3
RUN python -c 'import sqlalchemy; from mlflow.store.tracking.sqlalchemy_store import SqlAlchemyStore as TrackingStore; from mlflow.store.model_registry.sqlalchemy_store import SqlAlchemyStore as RegistryStore; print({"sqlalchemy": sqlalchemy.__version__, "tracking_store": TrackingStore.__module__, "registry_store": RegistryStore.__module__})'
RUN useradd --uid 10001 --create-home mlflow
USER mlflow
EXPOSE 5000
ENTRYPOINT ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--serve-artifacts", "--artifacts-destination", "s3://ml-artifacts", "--allowed-hosts", "mlflow:5000,localhost:5000,127.0.0.1:5000"]
